#usda 1.0
(
    defaultPrim = "ShovelTool"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ShovelTool" (
    kind = "component"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.12
    # The centre of mass is in tool-local metres: 90 mm toward the metal blade
    # on -Y, centred laterally on X, and 10 mm below the root on -Z. It lies
    # inside the authored wedge footprint (-135 to -60 mm Y) and models a
    # blade-heavy 0.12 kg toy shovel.  With auto-computed mass distribution,
    # the new rear grip made gate task4_gripfix_gate_03 rock steadily at
    # 0.11815 rad/s even after 150 fixed settle steps.  Moving the COM less
    # negative can repeat that torque; moving it outside the blade footprint
    # or below the table would be unphysical.  This fixed asset calibration
    # must satisfy the unchanged 0.05 rad/s reset gate before any plan exists.
    point3f physics:centerOfMass = (0.0, -0.090, -0.010)
    bool physics:rigidBodyEnabled = true

    # The five backplate-frame rails alone receive dimensionless static/dynamic friction
    # 20/15 with max-combine and zero restitution.  These deliberately large
    # values preserve the existing high-grip hand-contact calibration and exceed
    # the public block's already validated 10/1.5 surface. Lower values can
    # repeat the rollout-01 slip; still larger values can amplify finger
    # impulses. Binding this material only to the socket rails prevents the
    # blade from sticking to the table. It is a fixed asset property, never a
    # feedback gain.
    def Material "GripPhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
    )
    {
        float physics:staticFriction = 20.0
        float physics:dynamicFriction = 15.0
        float physics:restitution = 0.0
        token physxMaterial:frictionCombineMode = "max"
    }

    def Scope "Geometry"
    {
        # The root is one dynamic body. These five rails are the vertical rear
        # plate of the L-shaped shovel, fixed by hierarchy rather than by a
        # joint or attachment. Tool-local +X is lateral/closing, -Y points
        # toward the blade/front, and +Z is up. The plate is 12 mm thick about
        # Y=-52 mm and spans X=[-70,+70] mm, Z=[-10,+55] mm. Its two
        # X-Z openings, [-64,-4]x[+5,+45] mm and
        # [+4,+64]x[+5,+45] mm, are genuine through-holes: only the outer
        # rails, central rib, and top/bottom rails have collision APIs. The
        # 60x40 mm apertures come from the measured Dex1 open-to-closed finger
        # sweep at that Y plane; making them smaller blocks insertion, while
        # larger holes weaken the central/outer bearing surfaces. They are a
        # fixed first physical candidate and require visible inspect, reset-time
        # clearance, and physical lift validation after any change.
        def Xform "dual_finger_socket"
        {
            # The restrained dark finish distinguishes the backplate frame
            # from the metal blade without adding a visual target.
            def Cube "left_outer_rail" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                float size = 1
                float3 xformOp:translate = (-0.067, -0.052, 0.0225)
                float3 xformOp:scale = (0.003, 0.006, 0.0325)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                rel material:binding:physics = </ShovelTool/GripPhysicsMaterial> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.28, 0.31, 0.35)]
            }

            def Cube "right_outer_rail" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                float size = 1
                float3 xformOp:translate = (0.067, -0.052, 0.0225)
                float3 xformOp:scale = (0.003, 0.006, 0.0325)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                rel material:binding:physics = </ShovelTool/GripPhysicsMaterial> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.28, 0.31, 0.35)]
            }

            def Cube "central_rib" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                float size = 1
                float3 xformOp:translate = (0.0, -0.052, 0.0225)
                float3 xformOp:scale = (0.004, 0.006, 0.0325)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                rel material:binding:physics = </ShovelTool/GripPhysicsMaterial> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.28, 0.31, 0.35)]
            }

            def Cube "top_rail" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                float size = 1
                float3 xformOp:translate = (0.0, -0.052, 0.050)
                float3 xformOp:scale = (0.070, 0.006, 0.005)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                rel material:binding:physics = </ShovelTool/GripPhysicsMaterial> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.28, 0.31, 0.35)]
            }

            # This bottom rail is also the L-shaped blade's physical
            # backstop. Its lower face at -10 mm meets the wedge's -9 mm rear
            # top (1 mm overlap), avoiding a visible or collision gap. The
            # 15 mm height leaves the hole floor at +5 mm; making it lower can
            # disconnect the frame, while making it higher consumes finger
            # clearance. It is fixed to the measured asset geometry.
            def Cube "backstop" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                float size = 1
                float3 xformOp:translate = (0.0, -0.052, -0.0025)
                float3 xformOp:scale = (0.070, 0.006, 0.0075)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                rel material:binding:physics = </ShovelTool/GripPhysicsMaterial> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.28, 0.31, 0.35)]
            }
        }

        # This convex mesh is a genuine 75 mm long by 90 mm wide wedge rather
        # than a renamed flat box. Local -Y is the leading edge, +X spans the
        # width, and +Z is up. Its front is 1 mm thick and its rear is 8 mm
        # thick: the 7 mm rise over 75 mm gives a 5.33 degree ramp, shallow
        # enough to approach the public 50 mm cube without disabling table
        # collision. A steeper wedge tends to shove the cube; a thinner lip is
        # numerically fragile at the public 1 mm rest offset. This is a fixed
        # first-pass geometry that needs visible contact validation.
        def Mesh "shallow_wedge_blade" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            point3f[] points = [
                (-0.045, -0.135, -0.017), (0.045, -0.135, -0.017),
                (-0.045, -0.135, -0.016), (0.045, -0.135, -0.016),
                (-0.045, -0.060, -0.017), (0.045, -0.060, -0.017),
                (-0.045, -0.060, -0.009), (0.045, -0.060, -0.009)
            ]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [
                0, 4, 5, 1,
                2, 3, 7, 6,
                0, 2, 6, 4,
                1, 5, 7, 3,
                0, 1, 3, 2,
                4, 6, 7, 5
            ]
            uniform token subdivisionScheme = "none"
            color3f[] primvars:displayColor = [(0.64, 0.67, 0.72)]
        }

    }
}
